@startuml dc-adicionar_comentario
autonumber
skinparam style strictuml

actor Leitor as "Leitor"
participant Client           as "Aplicação Cliente"
participant ServiceAvaliacao as "Serviço de Avaliação"
database    BD               as "Banco de Dados"

Leitor -> Client : clica em "Adicionar comentário"\nou "Editar comentário" na sua avaliação

Client -> ServiceAvaliacao : GET /avaliacoes/{id}(leitorId)
ServiceAvaliacao -> BD : SELECT avaliacao WHERE\nid = {id} AND leitorId = {id}
BD --> ServiceAvaliacao : avaliação existente
ServiceAvaliacao --> Client : dados da avaliação

Client --> Leitor : exibe campo de texto\ncom conteúdo atual (se houver)

Leitor -> Client : digita ou edita o texto\ndo comentário e confirma

Client -> ServiceAvaliacao : PATCH /avaliacoes/{id}(texto)

ServiceAvaliacao -> BD : UPDATE avaliacao SET texto = {texto},\ndataHora = NOW() WHERE id = {id}
BD --> ServiceAvaliacao : comentário atualizado

ServiceAvaliacao --> Client : 200 OK — comentário salvo

Client --> Leitor : exibe avaliação atualizada\ncom o novo comentário

@enduml
