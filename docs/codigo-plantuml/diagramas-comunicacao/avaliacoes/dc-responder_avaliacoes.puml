@startuml ds-responder_avaliacoes
autonumber
skinparam style strictuml

actor UsuarioEditorial as "UsuárioEditorial"
participant Client           as "Aplicação Cliente"
participant ServiceAvaliacao as "Serviço de Avaliação"
database    BD               as "Banco de Dados"

UsuarioEditorial -> Client : acessa dashboard e abre\na seção "Avaliações" do livro

Client -> ServiceAvaliacao : GET /livros/{livroId}/avaliacoes
ServiceAvaliacao -> BD : SELECT avaliacoes WHERE\nlivroId = {id} ORDER BY dataHora DESC
BD --> ServiceAvaliacao : lista de avaliações
ServiceAvaliacao --> Client : avaliações com seus comentários

Client --> UsuarioEditorial : exibe lista de avaliações\ndo livro

UsuarioEditorial -> Client : seleciona uma avaliação\ne clica em "Responder"

Client -> ServiceAvaliacao : GET /avaliacoes/{id}
ServiceAvaliacao -> BD : SELECT avaliacao WHERE id = {id}
BD --> ServiceAvaliacao : dados da avaliação

ServiceAvaliacao -> BD : SELECT comentarioAvaliacao WHERE\navaliacaoId = {id}\nAND autorId = {usuarioEditorialId}
BD --> ServiceAvaliacao : resposta prévia (ou vazia)
ServiceAvaliacao --> Client : avaliação e resposta prévia (se houver)

Client --> UsuarioEditorial : exibe campo de texto em branco
UsuarioEditorial -> Client  : digita resposta e confirma
Client -> ServiceAvaliacao  : POST /avaliacoes/{id}/comentarios\n(autorId, texto, deAutorEditora = true)
ServiceAvaliacao -> BD : INSERT comentarioAvaliacao\n(avaliacaoId, autorId, texto,\ndeAutorEditora = true, dataHora)
BD --> ServiceAvaliacao : resposta criada (id)
ServiceAvaliacao --> Client : 201 Created
Client --> UsuarioEditorial : exibe campo com texto atual
UsuarioEditorial -> Client  : edita resposta e confirma
Client -> ServiceAvaliacao  : PATCH /avaliacoes/{id}/comentarios/{comentId}\n(texto)
ServiceAvaliacao -> BD : UPDATE comentarioAvaliacao\nSET texto = {texto}, dataHora = NOW()\nWHERE id = {comentId}
BD --> ServiceAvaliacao : resposta atualizada
ServiceAvaliacao --> Client : 200 OK

Client --> UsuarioEditorial : exibe resposta publicada\nna thread da avaliação\n(com badge "Autor" ou "Editora")

@enduml
