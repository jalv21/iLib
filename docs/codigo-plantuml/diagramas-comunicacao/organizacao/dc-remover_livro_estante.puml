@startuml dc-remover_livro_estante
autonumber
skinparam style strictuml

actor Usuario as "Usuário"
participant Client            as "Aplicação Cliente"
participant ServiceBiblioteca as "Serviço de Biblioteca"
database    BD                as "Banco de Dados"

Usuario -> Client : clica em "Remover da Estante"\nno livro dentro de uma estante

Client --> Usuario : exibe diálogo de confirmação\n"Remover este livro da estante?"

Usuario -> Client : confirma remoção

Client -> ServiceBiblioteca : DELETE /estantes/{estanteId}/livros/{livroId}\n(usuarioId)

ServiceBiblioteca -> BD : SELECT estante WHERE\nid = {estanteId} AND usuarioId = {id}
BD --> ServiceBiblioteca : estante pertence ao usuário

ServiceBiblioteca -> BD : DELETE FROM estante_livro WHERE\nestanteId = {id} AND livroId = {id}
BD --> ServiceBiblioteca : associação removida

ServiceBiblioteca --> Client : 200 OK

Client --> Usuario : remove livro da estante\ne atualiza contador

@enduml
