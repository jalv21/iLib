@startuml diagrama-classe
skinparam linetype ortho

abstract class Usuario {
    # nome: String
    # email: String
    # username: String
    # senha: String
    # biblioteca: Biblioteca
    # comentariosAvaliacao: List<ComentarioAvaliacao>
    + cadastrar(): void {abstract}
    + login(): void {abstract}
}

interface IComentador {
    + comentarAvaliacao(): void
    + editarComentario(): void
    + excluirComentario(): void
}

interface IPublicador {
    + cadastrarLivro(): void {abstract}
    + editarLivro(): void {abstract}
    + arquivarLivro(): void {abstract}
    + removerLivro(): void {abstract}
}

class AutorIndependente {
    - cpf: String
}
AutorIndependente --|> Usuario
AutorIndependente ..|> IPublicador
AutorIndependente ..|> IComentador

class Editora {
    - cnpj: String
    - autoresLicenciados: List<String>
}
Editora --|> Usuario
Editora ..|> IPublicador
Editora ..|> IComentador

interface IAvaliador {
    + avaliarLivro(): void
    + editarAvaliacao(): void
    + excluirAvaliacao(): void
}

class Leitor {
    - avaliacoes: List<Avaliacao>
    + comprarLivro(): void
    + lerLivro(): void
}
Leitor --|> Usuario
Leitor ..|> IComentador
Leitor ..|> IAvaliador
@enduml