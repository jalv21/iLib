@startuml diagrama-classe
skinparam linetype ortho

abstract class Usuario {
    # nome: String
    # email: String
    # username: String
    # senha: String
    # biblioteca: List<Estante>
    # comentariosAvaliacao: List<ComentarioAvaliacao>
    + cadastrar(): void {abstract}
    + login(): void {abstract}
    + criarEstante(): void
    + removerEstante(): void
}
Usuario "1" *-- "*" Estante

interface IComentador {
    + comentarAvaliacao(): void
    + editarComentario(): void
    + excluirComentario(): void
}
Usuario ..|> IComentador

interface IPublicador {
    + cadastrarLivro(): void
    + editarLivro(): void
    + arquivarLivro(): void
    + removerLivro(): void
}

class AutorIndependente {
    - cpf: String
}
AutorIndependente --|> Usuario
AutorIndependente ..|> IPublicador

class Editora {
    - cnpj: String
    - autoresLicenciados: List<String>
}
Editora --|> Usuario
Editora ..|> IPublicador

interface IAvaliador {
    + avaliarLivro(): void
    + editarAvaliacao(): void
    + excluirAvaliacao(): void
}

class Leitor {
    - avaliacoes: List<Avaliacao>
    + comprarLivro(): void
    + lerLivro(): void
}
Leitor --|> Usuario
Leitor ..|> IAvaliador

class Estante {
    - nome: String
    - criador: Usuario
    - livros: List<Livro>
    - subEstantes: List<Estante> 
    - editorial: boolean
    - privada : boolean
    + adicionarLivro(): void
    + removerLivro(): void
    + criarSubEstante(): void
    + removerSubEstante(): void
}
Estante "*" *-- "1..*" Livro

class Livro <<record>>{
    - titulo: String
    - nomeAutor: String
    - publicador: IPublicador
    - isbn: String
    - preco: Double
    - generos: List<EGenero>
    - dataPublicacao: Date
    - sinopse: String
    - mediaAvaliacao: Double
    - avaliacoes: List<Avaliacao>
    - capaUrl: String
    - arquivoBucketKey: String
}
Livro "*" *-- "1..*" EGenero

enum EGenero {
    ACAO,
    AVENTURA,
    DRAMA,
    FANTASIA,
    FICCAO,
    FICCAO-CIENTIFICA,
    FICCAO-HISTORICA,
    FICCAO-LITERARIA,
    NAO-FICCAO,
}
@enduml